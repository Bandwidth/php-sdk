{
    "name": "bandwidth/sdk",
    "description": "Bandwidth's Communication APIs",
    "keywords": [
        "openapitools",
        "openapi-generator",
        "openapi",
        "php",
        "sdk",
        "rest",
        "api"
    ],
    "homepage": "https://github.com/Bandwidth/php-sdk",
    "license": "MIT",
    "authors": [
        {
            "name": "Bandwidth",
            "homepage": "https://www.bandwidth.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.4.5",
        "guzzlehttp/psr7": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.5",
        "overtrue/phplint": "^9.0",
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": { "Bandwidth\\" : "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Bandwidth\\Test\\" : "tests/" }
    },
    "scripts": {
        "test:unit": "phpunit tests/Unit",
        "test:smoke": "phpunit tests/Smoke",
        "phplint": "phplint"
    }
}
